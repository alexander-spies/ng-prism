# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
.posts

# npm auth tokens (project-level login)
.npmrc
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

test-output

# video: render output of the product-video pipeline (recordings, masters,
# deliverables). Only the tour and its poster under docs/assets/video/ are committed.
video/out

# test-workspace: Angular CLI workspace for local testing. Sources of the
# test libs and both prism apps are committed, generated files are not.
test-workspace/node_modules
test-workspace/dist
test-workspace/.angular
test-workspace/.env
test-workspace/package-lock.json
test-workspace/ng-prism.config.ts
# Written by `npm run test:coverage`, read by the coverage plugin.
# Not committed: contains absolute paths of the machine that produced it.
test-workspace/coverage
test-workspace/**/*.d.ts
test-workspace/tsconfig.tsbuildinfo

**/plugin-registry.ts
.worktrees/
ng-prism-cache/

# Local scratch directory of agent tooling
.superpowers/

# AI agent config: project skills live in .agents/skills (Codex and Copilot read it natively),
# .claude/skills holds one relative symlink per skill for Claude Code. Only the prism-* skills and agents
# are tracked; personal skills and agents without the prefix, settings, specs, ADRs etc. stay local.
# .agents/plugins/claude is the Claude Code plugin for ng-prism users; .claude-plugin/ makes the repo its marketplace.
# No trailing slash on the .claude/skills entry: git stores the symlinks as files, not directories.
!/.agents
/.agents/*
!/.agents/plugins
!/.agents/skills
/.agents/skills/*
!/.agents/skills/prism-*
!/.claude
/.claude/*
!/.claude/skills
/.claude/skills/*
!/.claude/skills/prism-*
!/.claude/agents
/.claude/agents/*
!/.claude/agents/prism-*.md
/.agents/**/.DS_Store
/.claude/**/.DS_Store
# CLAUDE.md is a symlink to AGENTS.md and shared (overrides a global ignore); personal notes go into CLAUDE.local.md
!/CLAUDE.md
CLAUDE.local.md
