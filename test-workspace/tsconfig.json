{
    "compilerOptions": {
        "baseUrl": "./",
        "ignoreDeprecations": "6.0",
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "strict": true,
        "skipLibCheck": true,
        "importHelpers": true,
        "sourceMap": true,
        "lib": ["ES2022", "dom"],
        "paths": {
            "@ng-prism/core": ["node_modules/ng-prism"],
            "@ng-prism/core/*": ["node_modules/ng-prism/*"],
            "ng-prism.config": ["ng-prism.config.ts"],
            "prism-manifest/*": ["ng-prism-cache/*/prism-manifest.ts"],
            "test-lib": ["projects/test-lib/src/public-api.ts"],
            "test-ui-kit": ["projects/test-ui-kit/public-api.ts"],
            "test-ui-kit/*": ["projects/test-ui-kit/*/public-api.ts"],
            "video-lib": ["projects/video-lib/src/public-api.ts"],
            "video-lib.prism.config": ["video-lib.prism.config.ts"]
        }
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    },
    "exclude": ["**/*.spec.ts"],
    "references": [
        {
            "path": "../packages/ng-prism"
        }
    ],
    "nx": {
        "addTypecheckTarget": false
    }
}
