{
    "name": "ng-prism-video",
    "version": "0.0.0",
    "private": true,
    "description": "Builds the ng-prism product videos from scripted styleguide recordings and Revideo scenes.",
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "test": "node --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" \"record/**/*.test.ts\"",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.scenes.json && npm test",
        "format": "node ../node_modules/prettier/bin/prettier.cjs --write \"{src,scripts,record}/**/*.{ts,tsx}\" \"*.json\"",
        "prereqs": "node scripts/prereqs.ts",
        "record": "node record/record.ts",
        "render": "node scripts/render.ts",
        "export": "node scripts/export.ts",
        "video": "node scripts/video.ts"
    },
    "dependencies": {
        "@codemirror/language": "^6.13.1",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@lezer/javascript": "^1.5.6",
        "@revideo/2d": "0.11.0",
        "@revideo/core": "0.11.0",
        "@revideo/ffmpeg": "0.11.0",
        "@revideo/renderer": "0.11.0",
        "@revideo/ui": "0.11.0",
        "@revideo/vite-plugin": "0.11.0",
        "vite": "^8.1.2"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "playwright": "1.63.0",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "posthog-node": "5.56.4"
    }
}
