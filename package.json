{
    "name": "ng-prism-workspace",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "docs": "npx docsify-cli serve docs --port 3000",
        "build": "nx build ng-prism",
        "build:all": "nx build ng-prism && nx run-many -t build --projects='plugin-box-model,plugin-figma,plugin-jsdoc,plugin-perf,plugin-coverage,plugin-visual-regression'",
        "test": "nx test ng-prism",
        "check": "nx format:check && node scripts/check-declared-deps.mjs && npm run style && nx run-many -t lint test build typecheck",
        "check:fix": "npm run lint:fix && nx format:write && npm run style:fix",
        "lint": "nx run-many -t lint",
        "lint:fix": "node scripts/fix-until-stable.mjs eslint .",
        "publish": "./scripts/publish.sh",
        "verdaccio": "nx run ng-prism-workspace:local-registry",
        "test:workspace:kill": "lsof -ti :4400 | xargs kill -9 2>/dev/null || echo 'No process on port 4400'",
        "test:workspace:setup": "nx build ng-prism --skip-nx-cache",
        "test:workspace:install": "cd test-workspace && npm install && (test -f ng-prism.config.ts || cp ng-prism.config.example.ts ng-prism.config.ts)",
        "test:workspace:update": "npm run test:workspace:kill && nx run-many -t build --projects='ng-prism,plugin-box-model,plugin-coverage,plugin-figma,plugin-jsdoc,plugin-perf,plugin-visual-regression' && cd test-workspace && rm -rf .angular/cache && npm install --prefer-offline --no-audit --no-fund",
        "test:workspace:serve": "cd test-workspace && npx ng run test-lib:prism",
        "test:workspace:build": "cd test-workspace && npx ng run test-lib:prism-build",
        "test:workspace:clean": "cd test-workspace && rm -rf node_modules package-lock.json ng-prism.config.ts && git checkout -- angular.json package.json",
        "test:workspace:reset": "npm run test:workspace:clean && npm run test:workspace:setup && npm run test:workspace:install",
        "video:install": "npm --prefix video ci",
        "video": "npm --prefix video run video --",
        "check:deps": "node scripts/check-declared-deps.mjs",
        "style": "stylelint --allow-empty-input '**/*.{css,scss}'",
        "style:fix": "stylelint --allow-empty-input --fix '**/*.{css,scss}'",
        "prepare": "husky"
    },
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "lint-staged": {
        "*.ts": [
            "node scripts/fix-until-stable.mjs eslint"
        ],
        "*.html": [
            "node scripts/fix-until-stable.mjs eslint",
            "prettier --write --ignore-unknown"
        ],
        "*.{json,md,yml,js,mjs,cjs}": [
            "prettier --write --ignore-unknown"
        ],
        "*.{css,scss}": [
            "prettier --write --ignore-unknown",
            "node scripts/fix-until-stable.mjs stylelint"
        ]
    },
    "devDependencies": {
        "@angular-devkit/architect": "^0.2201.8",
        "@angular-devkit/core": "^22.1.8",
        "@angular-devkit/schematics": "^22.1.8",
        "@angular/cdk": "^22.1.7",
        "@angular/common": "^22.1.7",
        "@angular/compiler": "^22.1.7",
        "@angular/compiler-cli": "^22.1.7",
        "@angular/core": "^22.1.7",
        "@angular/platform-browser": "^22.1.7",
        "@eslint/js": "^9.39.5",
        "@nx/eslint": "22.7.12",
        "@nx/jest": "22.7.12",
        "@nx/js": "22.7.12",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@swc-node/register": "1.11.1",
        "@swc/core": "1.15.8",
        "@swc/helpers": "0.5.18",
        "@swc/jest": "~0.2.38",
        "@types/jest": "^30.0.0",
        "@types/node": "20.19.9",
        "angular-eslint": "~22.0",
        "axe-core": "^4.11.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^14.0.0",
        "highlight.js": "^11.11.1",
        "html2canvas": "^1.4.1",
        "husky": "^9.1.7",
        "jest": "^30.0.2",
        "jest-environment-jsdom": "^30.3.0",
        "jest-environment-node": "^30.0.2",
        "jest-util": "^30.0.2",
        "lint-staged": "^17.6.0",
        "ngx-highlightjs": "^14.0.1",
        "nx": "22.7.12",
        "pixelmatch": "^7.1.0",
        "playwright": "^1.58.2",
        "prettier": "^3.9.9",
        "reflect-metadata": "^0.2.2",
        "stylelint": "^17.15.0",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^7.0.1",
        "ts-jest": "^29.4.0",
        "ts-node": "10.9.1",
        "tslib": "^2.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "verdaccio": "^6.7.2"
    },
    "overrides": {
        "@babel/core": "^7.29.7",
        "axios": "^1.18.0",
        "baseline-browser-mapping": "^2.11.0",
        "body-parser": "^1.20.6",
        "brace-expansion": "^5.0.9",
        "browserslist": "^4.28.7",
        "fast-uri": "^3.1.6",
        "form-data": "^4.0.6",
        "js-yaml": "^4.3.2",
        "minimatch": "^10.2.5",
        "picomatch": "^4.0.4",
        "qs": "^6.16.0",
        "smol-toml": "^1.7.1",
        "tmp": "^0.2.7",
        "uuid": "^11.1.1"
    },
    "nx": {
        "includedScripts": [],
        "targets": {
            "local-registry": {
                "executor": "@nx/js:verdaccio",
                "options": {
                    "port": 4873,
                    "config": ".verdaccio/config.yml",
                    "storage": "tmp/local-registry/storage",
                    "location": "none"
                }
            },
            "lint": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "eslint scripts jest.config.ts .agents"
                },
                "cache": true,
                "inputs": [
                    "{workspaceRoot}/scripts/**/*.mjs",
                    "{workspaceRoot}/.agents/**/*.mjs",
                    "{workspaceRoot}/jest.config.ts",
                    "{workspaceRoot}/eslint.config.mjs",
                    "{workspaceRoot}/.prettierrc",
                    "{workspaceRoot}/.prettierignore",
                    {
                        "externalDependencies": [
                            "eslint",
                            "prettier",
                            "eslint-plugin-prettier"
                        ]
                    }
                ]
            }
        }
    }
}
