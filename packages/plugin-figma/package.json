{
    "name": "@ng-prism/plugin-figma",
    "version": "22.7.0-beta.1",
    "description": "Figma design embed panel for ng-prism.",
    "ng-add": {
        "save": "devDependencies"
    },
    "schematics": "./schematics/collection.json",
    "keywords": [
        "@ng-prism/core",
        "figma",
        "plugin",
        "angular",
        "styleguide"
    ],
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "schematics",
        "!**/*.tsbuildinfo"
    ],
    "peerDependencies": {
        "@angular/core": ">=20.0.0",
        "html2canvas": ">=1.4.0",
        "pixelmatch": ">=6.0.0",
        "@ng-prism/core": "^22.7.0-0",
        "@angular-devkit/schematics": ">=20.0.0"
    },
    "peerDependenciesMeta": {
        "html2canvas": {
            "optional": true
        },
        "pixelmatch": {
            "optional": true
        }
    },
    "devDependencies": {
        "@ng-prism/core": "*"
    },
    "dependencies": {
        "tslib": "^2.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ng-prism/ng-prism.git",
        "directory": "packages/plugin-figma"
    },
    "homepage": "https://ng-prism.github.io/ng-prism/",
    "bugs": "https://github.com/ng-prism/ng-prism/issues"
}
