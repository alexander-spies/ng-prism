{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "paths": {
            "@ng-prism/core": ["../ng-prism/dist/index.d.ts"],
            "@ng-prism/core/*": ["../ng-prism/dist/*/index.d.ts"]
        }
    },
    "angularCompilerOptions": {
        "compilationMode": "full"
    },
    "include": ["src/**/*.ts"],
    "references": [],
    "exclude": ["jest.config.ts", "jest.config.cts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__fixtures__/**", "src/test-setup.ts"]
}
