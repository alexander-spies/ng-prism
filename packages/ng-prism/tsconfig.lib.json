{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "angularCompilerOptions": {
        "compilationMode": "full"
    },
    "include": ["src/**/*.ts"],
    "references": [],
    "exclude": ["jest.config.ts", "jest.config.cts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__fixtures__/**", "src/**/__mocks__/**", "src/**/__test-utils__/**"]
}
