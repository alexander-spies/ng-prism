{
    "base": "http://127.0.0.1:4431/",
    "cssName": "ui-video.css",
    "steps": [
        {
            "goto": "?component=ButtonComponent"
        },
        {
            "capture": "btn",
            "marks": [
                {
                    "selector": ".sb-item",
                    "text": "Button",
                    "as": "sb-button"
                },
                {
                    "selector": ".prism-tab",
                    "text": "Ghost",
                    "as": "tab-ghost"
                },
                {
                    "selector": "input.ctl-text",
                    "as": "label"
                },
                {
                    "selector": "button",
                    "text": "ghost",
                    "as": "ctl-ghost"
                },
                {
                    "selector": "ui-button button",
                    "as": "canvas-btn"
                },
                {
                    "selector": "button[aria-label='Canvas, state, zoom and width']",
                    "as": "tools"
                },
                {
                    "selector": ".prism-tab",
                    "text": "Box Model",
                    "as": "box-tab"
                }
            ]
        },
        {
            "click": ".prism-tab[aria-label='Ghost']",
            "wait": 1200
        },
        {
            "capture": "btn-ghost"
        },
        {
            "goto": "?component=ButtonComponent"
        },
        {
            "fill": "input.ctl-text",
            "text": "Ship it",
            "wait": 900
        },
        {
            "eval": "document.activeElement && document.activeElement.blur()"
        },
        {
            "capture": "ctl-label",
            "marks": [
                {
                    "selector": "button",
                    "text": "ghost",
                    "as": "ctl-ghost"
                },
                {
                    "selector": "ui-button button",
                    "as": "canvas-btn"
                }
            ]
        },
        {
            "click": ".ctl-pill:text-is('ghost')",
            "wait": 1000
        },
        {
            "eval": "document.activeElement && document.activeElement.blur()"
        },
        {
            "capture": "ctl-ghost",
            "marks": [
                {
                    "selector": "ui-button button",
                    "as": "canvas-btn"
                }
            ]
        },
        {
            "click": "ui-button button",
            "wait": 1200
        },
        {
            "eval": "document.activeElement && document.activeElement.blur()"
        },
        {
            "capture": "ctl-clicked",
            "marks": [
                {
                    "selector": ".prism-tab",
                    "text": "Events",
                    "as": "events-tab"
                }
            ]
        },
        {
            "goto": "?component=ButtonComponent"
        },
        {
            "click": "button:text-is('Reset')",
            "wait": 900
        },
        {
            "goto": "?component=ButtonComponent"
        },
        {
            "click": "button[aria-label='Canvas, state, zoom and width']",
            "wait": 900
        },
        {
            "capture": "st-tools",
            "marks": [
                {
                    "selector": "#prism-tools button",
                    "text": "Hover",
                    "as": "chip-hover"
                },
                {
                    "selector": "#prism-tools button",
                    "text": "Focus visible",
                    "as": "chip-focus"
                },
                {
                    "selector": "#prism-tools button",
                    "text": "Pressed",
                    "as": "chip-pressed"
                }
            ]
        },
        {
            "click": "#prism-tools button:text-is('Hover')",
            "wait": 900
        },
        {
            "capture": "st-hover"
        },
        {
            "click": "#prism-tools button:text-is('Focus visible')",
            "wait": 900
        },
        {
            "capture": "st-focus"
        },
        {
            "click": "#prism-tools button:text-is('Pressed')",
            "wait": 900
        },
        {
            "capture": "st-pressed"
        },
        {
            "press": "Escape",
            "wait": 600
        },
        {
            "click": ".prism-tab:has-text('Box Model')",
            "wait": 1200
        },
        {
            "hover": "ui-button button",
            "wait": 900
        },
        {
            "capture": "st-box",
            "marks": [
                {
                    "selector": ".prism-tab",
                    "text": "Box Model",
                    "as": "box-tab"
                }
            ]
        },
        {
            "goto": "?component=ButtonComponent&variant=1",
            "wait": 2500
        },
        {
            "eval": "new Promise((r) => setTimeout(r, 2500))"
        },
        {
            "capture": "a11y-before",
            "marks": [
                {
                    "selector": ".prism-tab",
                    "text": "A11y",
                    "as": "a11y-tab"
                },
                {
                    "selector": ".sb-health--danger",
                    "as": "mk-danger"
                },
                {
                    "selector": ".sb-health--warn",
                    "as": "mk-warn"
                }
            ]
        },
        {
            "click": ".prism-tab:has-text('A11y')",
            "wait": 1500
        },
        {
            "waitFor": "text=color-contrast"
        },
        {
            "eval": "document.activeElement && document.activeElement.blur()"
        },
        {
            "capture": "a11y-after",
            "marks": [
                {
                    "selector": ".sb-health--danger",
                    "as": "mk-danger"
                },
                {
                    "selector": ".sb-health--warn",
                    "as": "mk-warn"
                }
            ]
        }
    ]
}
