{
    "base": "http://127.0.0.1:4430/",
    "cssName": "ui-phone.css",
    "viewport": {
        "width": 390,
        "height": 844
    },
    "touch": true,
    "steps": [
        {
            "goto": "?component=ButtonComponent"
        },
        {
            "capture": "ph-btn",
            "marks": [
                {
                    "selector": "[aria-label='Open navigation']",
                    "as": "nav-toggle"
                }
            ]
        },
        {
            "click": "[aria-label='Open navigation']",
            "wait": 1000
        },
        {
            "capture": "ph-nav",
            "marks": [
                {
                    "selector": ".sb-item",
                    "text": "Toggle",
                    "as": "nav-toggle-item"
                }
            ]
        },
        {
            "click": ".sb-item:has-text('Toggle')",
            "wait": 1600
        },
        {
            "eval": "document.activeElement && document.activeElement.blur()"
        },
        {
            "capture": "ph-toggle"
        }
    ]
}
